---
source: crates/rudolint-dockerfile/tests/semantic.rs
expression: "graph.operations.iter().map(|operation|\n{\n    json!({\n        \"instruction_index\": operation.instruction_index, \"kind\": match\n        operation.kind { CopyKind::Copy => \"copy\", CopyKind::Add => \"add\", },\n        \"sources\": operation.sources, \"destination\": operation.destination,\n        \"from\": operation.from,\n    })\n}).collect::<Vec<_>>()"
---
