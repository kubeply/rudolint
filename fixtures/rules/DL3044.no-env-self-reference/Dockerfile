FROM alpine:3.20
ENV PATH=/usr/local/bin:$PATH
ENV APP_HOME=/app PATH=$APP_HOME/bin:$PATH
ENV NODE_VERSION=22 PATH=/opt/node-${NODE_VERSION}/bin:$PATH
ENV SELF=$SELF
ARG TOOL_HOME
ENV TOOL_HOME=/opt/tool PATH=$TOOL_HOME/bin:$PATH
ENV EXISTING=/opt/existing
ENV PATH=${EXISTING}/bin:$PATH NEXT=value
ENV FOO=bar BAZ=$FOOBAR
ENV FOO2=bar BAZ=$FOO2-suffix
